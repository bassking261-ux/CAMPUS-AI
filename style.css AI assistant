/* =========================
   AI ASSISTANT
========================= */

.assistant-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.assistant-header h2 {
    margin: 5px 0;
    font-size: 30px;
}

.clear-btn {
    border: 1px solid #dce5ed;
    background: white;
    padding: 10px 15px;
    border-radius: 9px;
    cursor: pointer;
}

.clear-btn:hover {
    background: #f1f6fa;
}

.chat-box {
    background: white;
    border: 1px solid #e3eaf1;
    border-radius: 18px;
    overflow: hidden;
}

.chat-messages {
    min-height: 430px;
    max-height: 500px;
    overflow-y: auto;
    padding: 25px;
}

.ai-message,
.user-message {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.message-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #e4f7fb;
    display: grid;
    place-items: center;
    flex-shrink: 0;
}

.ai-message p,
.user-message p {
    margin: 6px 0 0;
    line-height: 1.5;
}

.user-message {
    justify-content: flex-end;
}

.user-message .message-content {
    background: #092342;
    color: white;
    padding: 11px 15px;
    border-radius: 14px 14px 3px 14px;
    max-width: 70%;
}

.suggestions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    padding: 15px 20px;
    border-top: 1px solid #edf1f5;
}

.suggestions button {
    border: 1px solid #dce5ed;
    background: #f8fbfd;
    color: #31506d;
    padding: 8px 12px;
    border-radius: 20px;
    cursor: pointer;
    font-size: 12px;
}

.suggestions button:hover {
    background: #eaf7fa;
}

.chat-input-area {
    display: flex;
    gap: 10px;
    padding: 15px 20px;
    border-top: 1px solid #edf1f5;
}

.chat-input-area input {
    flex: 1;
    border: 1px solid #dce5ed;
    border-radius: 10px;
    padding: 13px;
    outline: none;
    font-size: 14px;
}

.chat-input-area input:focus {
    border-color: #159db1;
}

.chat-input-area button {
    border: none;
    background: #092342;
    color: white;
    padding: 0 20px;
    border-radius: 10px;
    cursor: pointer;
}

@media (max-width: 600px) {

    .assistant-header {
        align-items: flex-start;
        gap: 15px;
    }

    .chat-messages {
        min-height: 350px;
    }

    .chat-input-area button {
        padding: 0 13px;
    }

}
